# Alternative to Docker:
#   sudo useradd -r -m -d /opt/salesdesk salesdesk && sudo -u salesdesk python3 -m venv /opt/salesdesk/.venv
#   sudo -u salesdesk /opt/salesdesk/.venv/bin/pip install -e /opt/salesdesk
#   sudo cp deploy/salesdesk.service /etc/systemd/system/ && sudo systemctl enable --now salesdesk
[Unit]
Description=SalesDesk bot and dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=salesdesk
WorkingDirectory=/opt/salesdesk
EnvironmentFile=/opt/salesdesk/.env
ExecStart=/opt/salesdesk/.venv/bin/salesdesk
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
