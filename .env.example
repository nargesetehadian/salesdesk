# Copy to .env. The defaults below are for LOCAL DEVELOPMENT: only a bot token is needed.
APP_ENV=development

# --- Messengers: set one or both ---------------------------------------------
# Bale: create a bot with @botfather inside Bale. Telegram: @BotFather.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# --- Behaviour ----------------------------------------------------------------
TIMEZONE=Asia/Tehran
STALE_DAYS=10                 # days without contact before a customer is flagged
REMINDER_MINUTES=60           # how long before a meeting the reminder is sent
DIGEST_HOUR=8                 # local hour of the morning digest

# --- Infrastructure -----------------------------------------------------------
DB_PATH=data/salesdesk.db
DEMO_DB_PATH=data/demo.db     # used only by `make demo`; never your real data
BACKUP_DIR=data/backups
BACKUP_KEEP=7                 # daily snapshots to keep (0 disables)
WEB_HOST=127.0.0.1
WEB_PORT=8080
LOG_LEVEL=INFO

# --- PRODUCTION: set APP_ENV=production and fill in ALL of these -----------------
# The bot refuses to start in production without CEO_IDS, TEAM_CODE and DASHBOARD_KEY.
# Managers as platform:id (send /id to the bot). "bale:123,telegram:456"; a bare id matches any platform.
CEO_IDS=
# Employees send this code once to unlock the bot.
TEAM_CODE=
# Protects dashboard, API and exports (?key=...). 32+ random characters.
DASHBOARD_KEY=
# Public https address of the dashboard; enables the in-app Mini App button.
PUBLIC_URL=
